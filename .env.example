# Copy to .env.local and fill in when wiring Supabase (Phase: backend).
# Until these are set, the app runs on the in-memory mock repository.

# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Toggle the data source. "mock" (default) or "supabase".
NEXT_PUBLIC_DATA_SOURCE=mock
